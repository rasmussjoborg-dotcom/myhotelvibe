utique city hotels.","bookingUrl":"https://www.booking.com/hotel/dk/hotel-sp34.sv.html?aid=304142&label=gen173nr-10CAQoggJCJXNlYXJjaF9ob3RlbCBzcDM0IGNvcGVuaGFnZW4sIGRlbm1hcmtIM1gEaMgBiAEBmAEzuAEHyAEM2AED6AEB-AEBiAIBqAIBuALfqr_RBsACAdICJGQ3Yzk3ODU2LWM4ODQtNDlhZS05MjU1LTFjOTMyOTJlYTMyNNgCAeACAQ&sid=a046e38c1a35194e6f1caf99e85173ca&dist=0&group_adults=2&group_children=0&hapos=1&hpos=1&no_rooms=1&req_adults=2&req_children=0&room1=A%2CA&sb_price_type=total&sr_order=popularity&srepoch=1781519715&srpvid=8cfb4a6f281e0068&type=total&ucfs=1&","expediaUrl":null,"image2":null,"image3":null,"localGems":{"restaurant1":{"title":"Høst","description":"Experience modern Nordic cuisine in a stunning, rustic-chic setting. Høst offers an innovative tasting menu celebrating seasonal Danish produce, ideal for sparking culinary inspiration.","affiliateLink":"https://www.thefork.com/restaurant/host-r29699?aff_id=STITCH"},"restaurant2":{"title":"Barr","description":"Set in a historic waterfront building, Barr serves elevated traditional Nordic comfort food and an impressive selection of craft beers. A relaxed yet refined atmosphere perfect for creative conversations.","affiliateLink":"https://www.thefork.com/restaurant/barr-r603125?aff_id=STITCH"},"restaurant3":{"title":"Atelier September","description":"A minimalist, sun-drenched cafe renowned for its perfect avocado toast and fresh, seasonal dishes. An inspiring spot for a light lunch or creative brainstorming over coffee.","affiliateLink":"https://www.opentable.com/r/atelier-september-copenhagen?aff_id=STITCH"},"restaurant4":{"title":"Pluto","description":"A bustling, stylish bistro offering a vibrant atmosphere and delicious small plates perfect for sharing. It's a fantastic spot for a lively dinner and people-watching in the city.","affiliateLink":"https://www.thefork.com/restaurant/pluto-r13454?aff_id=STITCH"}},"seasonalPrices":{"autumn":380,"spring":350,"summer":480,"winter":290},"youtubeUrl":"","priceTier":"Boutique (€€)","primaryPer